---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import LocationCards from '@components/sections/LocationCards.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';
import { ceo, leaders } from '@/data/providers';

// Content comes from https://cynergypt.com/about/ (shortened and simplified).
const needs = [
  { title: 'Physical therapy', text: 'Care for pain, injuries, surgery recovery and movement goals, from head to toe.', href: '/what-we-treat/' },
  { title: 'Hand and occupational therapy', text: 'Therapists who focus on the hands, wrists, elbows and shoulders, including custom splints.', href: '/injuries/upper-extremity-conditions/' },
  { title: 'Pelvic floor therapy', text: 'Private, one on one care for pelvic health, from pregnancy to digestive and bladder concerns.', href: '/what-we-treat/pelvic-floor-health/' },
];

const values = ['Patient-focused, one on one care', 'Ongoing education for every therapist', 'Modern, well-kept equipment', 'Empathy and compassion', 'Community and diversity', 'Teamwork and steady improvement'];

const team = [ceo, ...leaders].slice(0, 8);
---

<BaseLayout
  title="About Cynergy | Cynergy Physical Therapy"
  description="Cynergy Physical Therapy and Occupational Therapy: one on one care from highly trained therapists, with warmth and humor, across six New York City locations."
>
  <PageHero
    eyebrow="About us"
    title="Our style of care."
    text="Highly trained, experienced therapists treat patients of all ages, from head to toe. Every visit is one on one, and we bring warmth and humor to the work."
    image={img.backTherapy}
    imageAlt="A Cynergy therapist treating a patient"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'At Cynergy' }]}
    primary={{ label: 'Book an appointment', href: '/appointment/' }}
    secondary={{ label: 'Call (212) 974-7252', href: 'tel:+12129747252' }}
  />

  <!-- Whatever your need -->
  <section class="py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Whatever your need" title="One team for your whole body." text="Physical, hand and pelvic floor therapists work side by side, so you can get the right care in one place." />
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {needs.map((n, i) => (
          <li data-reveal style={`--d:${i * 100}ms`}>
            <a href={n.href} class="group relative block h-full overflow-hidden rounded-xl border border-pine-900/10 bg-white p-8 transition duration-500 hover:-translate-y-1.5 hover:border-transparent hover:bg-pine-900 hover:shadow-xl hover:shadow-pine-950/20">
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-clay-500 transition-transform duration-500 group-hover:scale-x-100"></span>
              <span class="text-sm tabular-nums text-clay-600 transition-colors group-hover:text-clay-300">0{i + 1}</span>
              <h3 class="mt-4 text-2xl text-pine-950 transition-colors group-hover:text-white">{n.title}</h3>
              <p class="mt-3 text-ink/75 transition-colors group-hover:text-white/80">{n.text}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 transition-colors group-hover:text-white">Learn more <Arrow class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Getting well, better -->
  <section class="bg-cream-100 py-20 lg:py-28">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2">
      <div data-reveal class="aspect-[4/3] overflow-hidden rounded-xl bg-sage-200 lg:aspect-[4/5]">
        <img src={img.reformer} alt="Dr. Sarah Shafir doing a lunge on the Pilates reformer" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover" />
      </div>
      <div>
        <SectionHeading eyebrow="Getting well, better" title="Open talk and fresh thinking." text="Our therapists solve movement problems by talking openly with you and looking at each case in a new way. Good equipment helps you recover faster and with less fuss." />
        <div class="mt-8 rounded-xl border border-pine-900/10 bg-white p-7" data-reveal style="--d:120ms">
          <p class="eyebrow">Our mission</p>
          <p class="mt-3 text-lg text-pine-950">Individual, goal-focused care for endurance and recreational athletes, competitive athletes, and people hurt in accidents or in daily life.</p>
        </div>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2" data-reveal style="--d:200ms">
          {values.map((v) => (
            <li class="flex items-start gap-3 rounded-lg border border-pine-900/10 bg-white px-4 py-3 text-ink/85 transition hover:border-pine-900 hover:bg-pine-900 hover:text-white">
              <span class="mt-2.5 h-1.5 w-4 shrink-0 rounded-sm bg-clay-500"></span>{v}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section class="py-20 lg:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading eyebrow="Leadership" title="The people who lead our clinics." />
        <a href="/provider/" class="btn btn-outline" data-reveal>View all providers <Arrow /></a>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {team.map((p, i) => (
          <li data-reveal style={`--d:${(i % 4) * 80}ms`}>
            <a href={p.href} class="group block h-full overflow-hidden rounded-xl border border-pine-900/10 bg-white transition duration-500 hover:-translate-y-1.5 hover:border-pine-900 hover:shadow-xl hover:shadow-pine-950/10">
              <div class="aspect-[4/5] overflow-hidden bg-sage-200">
                <img src={p.image} alt={p.name} loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
              </div>
              <div class="p-5">
                <h3 class="font-serif text-xl text-pine-950">{p.name}</h3>
                <p class="mt-1 text-sm text-clay-600">{p.role}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Patient story -->
  <section class="bg-pine-900 py-20 text-white lg:py-28">
    <div class="container-x">
      <figure class="mx-auto max-w-3xl text-center" data-reveal>
        <svg class="mx-auto h-10 w-10 text-clay-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.2 6C4.9 7.7 3.5 10 3.5 13v5h6v-6H6.3c0-1.7.9-3.1 2.6-4.1L7.2 6Zm9.5 0c-2.3 1.7-3.7 4-3.7 7v5h6v-6h-3.2c0-1.7.9-3.1 2.6-4.1L16.7 6Z" /></svg>
        <blockquote class="mt-5 font-serif text-2xl leading-snug sm:text-3xl">Julia found Chivonne after trying several practices. She was back to her normal activity about a month after a hamstring strain.</blockquote>
        <p class="mt-5 text-white/80">She later worked with another therapist on conditioning and called the team the best of the best.</p>
        <figcaption class="mt-6 text-sm font-semibold uppercase tracking-[0.18em] text-clay-300">Julia, patient</figcaption>
        <a href="/patient-testimonials/" class="btn btn-outline-light mt-8">Read more reviews <Arrow /></a>
      </figure>
    </div>
  </section>

  <LocationCards eyebrow="Six clinics" title="Find a Cynergy near you." text="Every location offers one on one care. Choose the clinic that is closest to you." />

  <CtaBand />
</BaseLayout>
