---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import LocationCards from '@components/sections/LocationCards.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';
import { treatServices as services, servicePath } from '@/data/services';

// Short lines for the cards (same words as the home page cards).
const blurbs: Record<string, string> = {
  'back-pain': 'Relief for stiff, sore or injured backs, so you can sit, lift and move with ease.',
  'foot-ankle-pain': 'Care for sprains, heel pain and balance, from the ground up.',
  'hip-pain': 'Ease hip pain and get back to walking, running and climbing stairs.',
  'knee-pain': 'Rebuild strength and stability after an injury, surgery or arthritis.',
  'vestibular-dysfunction': 'Treatment for dizziness, vertigo and balance problems.',
  'upper-extremity-conditions': 'Hand and arm therapy for wrist, elbow and shoulder problems.',
  'pelvic-floor-health': 'Private, one-on-one care for pelvic pain, leaks and core support.',
  'temporomandibular-disorder': 'Relief for jaw pain, clicking and tension.',
  'chronic-pain': 'A steady, whole-person plan to manage pain that does not go away.',
};
---

<BaseLayout
  title="What We Treat | Physical Therapy in New York City | Cynergy"
  description="Back, foot and ankle, hip, knee, vestibular, upper extremity, pelvic floor, TMJ and chronic pain care at six Cynergy locations in New York City."
>
  <PageHero
    eyebrow="What we treat"
    title="Pain, injury and everything in between."
    text="At Cynergy, your goals come first. Choose a condition to learn how we help, then pick the clinic that is closest to you."
    areas="Patients are welcome from across Manhattan and Brooklyn, including Midtown, Chelsea, the Upper East Side and Cobble Hill."
    image={img.reformer}
    imageAlt="A therapist guiding a patient through an exercise"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'What We Treat' }]}
    primary={{ label: 'Book an appointment', href: '/appointment/' }}
    secondary={{ label: 'Call (212) 974-7252', href: 'tel:+12129747252' }}
  />

  <section class="py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Conditions" title="Find the care you need." text="Each service is offered at all six of our locations." />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, n) => (
          <li class="h-full" data-reveal style={`--d:${(n % 3) * 90}ms`}>
            <a href={servicePath(s)} class="group flex h-full flex-col overflow-hidden rounded-xl border border-pine-900/10 bg-white transition duration-500 hover:-translate-y-1.5 hover:border-transparent hover:shadow-xl hover:shadow-pine-950/15">
              <div class="relative aspect-[4/3] overflow-hidden bg-sage-200">
                <img src={s.image} alt={s.imageAlt} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-clay-500 transition-transform duration-500 group-hover:scale-x-100"></span>
              </div>
              <div class="flex flex-1 flex-col p-7">
                <p class="text-sm tabular-nums text-clay-600">{String(n + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 text-2xl text-pine-950">{s.label}</h3>
                <p class="mt-3 flex-1 text-ink/75">{blurbs[s.slug]}</p>
                <span class="mt-6 inline-flex items-center gap-2 font-medium text-pine-900">Learn more <Arrow class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <LocationCards eyebrow="Find a clinic" title="Care at six New York locations." text="Choose the clinic that is closest to you." />

  <CtaBand />
</BaseLayout>
