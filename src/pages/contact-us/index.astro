---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import SiteForm from '@components/islands/SiteForm';
import LocationCards from '@components/sections/LocationCards.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';
import { socials, newPatients } from '@/data/nav';
import type { Location } from '@/data/locations';

// Content comes from https://cynergypt.com/contact-us/ (shortened and simplified).
const ways = [
  { title: 'Book online', text: 'Pick a time that suits you on Zocdoc.', label: 'Book on Zocdoc', href: 'https://www.zocdoc.com/practice/cynergy-physical-therapy-p-c-147257?lock=true&isNewPatient=false&referrerType=widget' },
  { title: 'New patients', text: 'Fill out our appointment request.', label: newPatients.label, href: newPatients.href },
  { title: 'Returning patients', text: 'Use our online scheduling.', label: 'Returning patients', href: 'https://scheduling.go.promptemr.com/onlineScheduling?w=1143&s=DL' },
];
---

<BaseLayout
  title="Contact Us | Cynergy Physical Therapy"
  description="Contact Cynergy Physical Therapy in New York City. Call (212) 974-7252, send a message, or book online. Open Monday to Friday, 7 AM to 7 PM."
>
  <PageHero
    eyebrow="Contact us"
    title="Get in touch with us."
    text="Request an appointment online or call a patient liaison. We offer one on one physical, occupational and hand therapy."
    image={img.wide}
    imageAlt="A Cynergy therapist talking with a patient"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact us' }]}
    primary={{ label: 'Send us a message', href: '#contact-form' }}
    secondary={{ label: 'Call (212) 974-7252', href: 'tel:+12129747252' }}
  />

  <section class="py-20 lg:py-28">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div id="contact-form" class="scroll-mt-28 lg:col-span-7">
        <SectionHeading eyebrow="Send a message" title="How can we help?" text="Tell us a little and we will reply soon." />
        <div class="mt-10" data-reveal><SiteForm client:visible kind="contact" /></div>
      </div>

      <aside class="space-y-5 lg:col-span-5">
        <div class="rounded-xl bg-pine-950 p-8 text-white" data-reveal>
          <p class="eyebrow !text-clay-300">Office hours</p>
          <p class="mt-3 text-2xl">Monday to Friday</p>
          <p class="text-3xl">7:00 AM – 7:00 PM</p>
          <a href="tel:+12129747252" class="mt-6 inline-flex min-h-11 items-center text-xl font-semibold hover:text-clay-300">(212) 974-7252</a>
        </div>
        <div class="rounded-xl border border-pine-900/10 bg-cream-100 p-8" data-reveal style="--d:100ms">
          <p class="eyebrow">Same-day splinting</p>
          <p class="mt-3 text-ink/80">Walk-in patients who need a splint on the same day are welcome. Our Certified Hand Therapists make custom splints on site as part of your treatment plan.</p>
          <a href="/injuries/upper-extremity-conditions/" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 hover:text-clay-600">Hand therapy <Arrow class="h-4 w-4" /></a>
        </div>
        <ul class="flex gap-3" data-reveal style="--d:160ms">
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-md border border-pine-900/20 px-4 text-sm font-medium text-pine-900 transition hover:bg-pine-900 hover:text-white">{s.label}</a></li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="bg-cream-100 py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Book" title="Choose how you want to book." />
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {ways.map((w, i) => (
          <li data-reveal style={`--d:${i * 100}ms`}>
            <a href={w.href} target="_blank" rel="noopener noreferrer" class="group relative block h-full overflow-hidden rounded-xl border border-pine-900/10 bg-white p-8 transition duration-500 hover:-translate-y-1.5 hover:bg-pine-900 hover:shadow-xl hover:shadow-pine-950/20">
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-clay-500 transition-transform duration-500 group-hover:scale-x-100"></span>
              <h3 class="text-2xl text-pine-950 group-hover:text-white">{w.title}</h3>
              <p class="mt-3 text-ink/75 group-hover:text-white/80">{w.text}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 group-hover:text-white">{w.label} <Arrow class="h-4 w-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <LocationCards eyebrow="Our clinics" title="Visit us in person." text="Six clinics in Manhattan and Brooklyn." serviceHref={(l: Location) => l.href} serviceLabel={(l: Location) => `Visit Cynergy ${l.name}`} />
  <CtaBand />
</BaseLayout>
