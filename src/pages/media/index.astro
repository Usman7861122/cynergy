---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';
import { mediaPosts, postHref, formatDate } from '@/data/media-posts';
import { ceo, leaders } from '@/data/providers';

// Content comes from https://cynergypt.com/media/ and https://cynergypt.com/therapist-blogs/.
const [featured, ...rest] = mediaPosts;

const interviewNames = ['Cynthia Gormezano', 'Alvin Dike', 'Laurence V. Agénor'];
const interviews = interviewNames
  .map((n) => [ceo, ...leaders].find((p: any) => p.name === n))
  .filter(Boolean) as any[];

const patients = ['Dick Scanlan', 'Nora Swidler', 'Tom Flaherty'];

const latest = [
  { title: 'Meet Chivonne Henriques, PT, DPT, OCS, Clinical Director at Cynergy Cobble Hill', tag: 'Meet the team', href: '/biography/chivonne-henriques/' },
  { title: 'Bridging the Gap Between Physical Therapy & Performance Training', tag: 'Sports', href: '/sports-performance-training/' },
  { title: 'What does it mean to be a Certified Hand Therapist?', tag: 'Hand therapy', href: '/injuries/upper-extremity-conditions/' },
  { title: 'A collaborative approach to your care, built on strong ties with your referring doctor', tag: 'Our approach', href: '/about/' },
];

const tabs = [
  { id: 'articles', label: 'Articles' },
  { id: 'patients', label: 'Patient stories' },
  { id: 'interviews', label: 'Provider interviews' },
  { id: 'latest', label: 'Latest at Cynergy' },
];
---

<BaseLayout
  title="Media | Cynergy Physical Therapy"
  description="Articles, patient stories and provider interviews from Cynergy Physical Therapy in New York City."
>
  <PageHero
    eyebrow="Media"
    title="Learn, listen and get to know us."
    text="Read tips from our therapists, hear from patients and meet the people who care for you."
    image={img.portrait}
    imageAlt="A Cynergy therapist"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Media' }]}
    primary={{ label: 'Book an appointment', href: '/appointment/' }}
    secondary={{ label: 'Call (212) 974-7252', href: 'tel:+12129747252' }}
  />

  <nav aria-label="Media sections" class="sticky top-0 z-30 border-b border-pine-900/10 bg-cream-50/95 backdrop-blur">
    <ul class="container-x flex gap-2 overflow-x-auto py-3">
      {tabs.map((t) => (
        <li><a href={`#${t.id}`} class="inline-flex min-h-10 items-center whitespace-nowrap rounded-md border border-pine-900/15 px-4 text-sm font-medium text-pine-900 transition hover:border-pine-900 hover:bg-pine-900 hover:text-white">{t.label}</a></li>
      ))}
    </ul>
  </nav>

  <!-- Articles -->
  <section id="articles" class="scroll-mt-20 py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Articles" title="Tips from our therapists." text="Plain advice on pain, injuries and moving well." />

      <a href={postHref(featured)} class="group mt-12 grid overflow-hidden rounded-xl border border-pine-900/10 bg-white transition duration-500 hover:shadow-xl hover:shadow-pine-950/15 lg:grid-cols-2" data-reveal>
        <div class="aspect-[16/10] overflow-hidden bg-sage-200 lg:aspect-auto"><img src={featured.image} alt={featured.imageAlt} loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" /></div>
        <div class="flex flex-col justify-center p-8 lg:p-12">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-clay-600">Newest · {featured.category} · {formatDate(featured.date)}</p>
          <h3 class="mt-3 text-2xl leading-snug text-pine-950 sm:text-3xl">{featured.title}</h3>
          <p class="mt-4 text-ink/75">{featured.excerpt}</p>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 group-hover:text-clay-600">Read article <Arrow class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
        </div>
      </a>

      <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((p, i) => (
          <li data-reveal style={`--d:${(i % 3) * 100}ms`}>
            <a href={postHref(p)} class="group block h-full overflow-hidden rounded-xl border border-pine-900/10 bg-white transition duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-pine-950/15">
              <div class="aspect-[16/10] overflow-hidden bg-sage-200"><img src={p.image} alt={p.imageAlt} loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" /></div>
              <div class="p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-clay-600">{p.category} · {formatDate(p.date)}</p>
                <h3 class="mt-2 text-xl leading-snug text-pine-950">{p.short}</h3>
                <p class="mt-3 text-sm text-ink/70">{p.excerpt}</p>
                <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 group-hover:text-clay-600">Read <Arrow class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Patient stories -->
  <section id="patients" class="scroll-mt-20 bg-cream-100 py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Patient stories" title="In their own words." text="Watch real patients tell their Cynergy story." />
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {patients.map((n, i) => (
          <li data-reveal style={`--d:${i * 100}ms`}>
            <a href="https://www.youtube.com/channel/UC9nCJUxpGMy-FwlPYkNGxwg" target="_blank" rel="noopener noreferrer" class="group block h-full rounded-xl border border-pine-900/10 bg-white p-8 transition duration-500 hover:-translate-y-1.5 hover:bg-pine-900 hover:shadow-xl hover:shadow-pine-950/20">
              <span class="text-sm tabular-nums text-clay-600 group-hover:text-clay-300">0{i + 1}</span>
              <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-ink/60 group-hover:text-white/70">Cynergy patient testimonial</p>
              <h3 class="mt-2 text-2xl text-pine-950 group-hover:text-white">{n}</h3>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 group-hover:text-white">Watch on YouTube <Arrow class="h-4 w-4" /></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10"><a href="/patient-testimonials/" class="btn btn-outline">Read patient reviews <Arrow /></a></div>
    </div>
  </section>

  <!-- Provider interviews -->
  <section id="interviews" class="scroll-mt-20 py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Provider interviews" title="Meet the people behind your care." text="Hear how our leaders think about movement, care and community." />
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {interviews.map((p, i) => (
          <li data-reveal style={`--d:${i * 100}ms`}>
            <a href={p.href ?? '/about/'} class="group block overflow-hidden rounded-xl border border-pine-900/10 bg-white transition duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-pine-950/15">
              <div class="aspect-[4/3] overflow-hidden bg-sage-200"><img src={p.image} alt={p.name} loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover object-top transition duration-700 group-hover:scale-105" /></div>
              <div class="p-6">
                <h3 class="text-xl text-pine-950">{p.name}</h3>
                <p class="mt-1 text-sm text-ink/70">{p.role}</p>
                <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 group-hover:text-clay-600">Read bio <Arrow class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10"><a href="/provider/" class="btn btn-outline">View all providers <Arrow /></a></div>
    </div>
  </section>

  <!-- Latest -->
  <section id="latest" class="scroll-mt-20 bg-cream-100 py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="The latest at Cynergy" title="News from our clinics." />
      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {latest.map((l, i) => (
          <li data-reveal style={`--d:${(i % 2) * 100}ms`}>
            <a href={l.href} class="group relative block h-full overflow-hidden rounded-xl border border-pine-900/10 bg-white p-8 transition duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-pine-950/15">
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-clay-500 transition-transform duration-500 group-hover:scale-x-100"></span>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-clay-600">{l.tag}</p>
              <h3 class="mt-3 text-xl leading-snug text-pine-950 sm:text-2xl">{l.title}</h3>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-pine-900 group-hover:text-clay-600">Learn more <Arrow class="h-4 w-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
