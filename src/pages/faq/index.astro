---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Faq, { type FaqItem } from '@components/islands/Faq';
import CtaBand from '@components/sections/CtaBand.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';

// Questions and answers come from https://cynergypt.com/faq/ (shortened and simplified).
const faqs: FaqItem[] = [
  { q: 'What should I wear to my first appointment?', a: 'Wear comfortable clothes you can move in, like what you would wear to exercise. If you come from work or did not bring a change of clothes, we can give you a t-shirt and shorts. Every location has changing rooms and lockers.' },
  { q: 'Do you take my insurance?', a: 'Please call the office. A team member will check your insurance benefits for you.' },
  { q: 'Should I bring my X-rays, MRI reports or prescription?', a: 'Yes. Bring any X-rays and MRI reports you have, and your prescription if you have one. You will also fill out some basic paperwork for your first evaluation.' },
  { q: 'Will I always see the same therapist?', a: 'In general, yes. You keep the therapist you start with. We make exceptions for things like scheduling conflicts or special diagnoses.' },
  { q: 'How often will I come?', a: 'Most treatment plans call for 2–3 visits a week, depending on your condition and physical ability. Sessions usually last 30–40 minutes. A plan typically runs 6–12 weeks, with regular re-evaluations and follow-up visits with your doctor.' },
];

const facts = [
  { big: '2–3', label: 'visits a week', text: 'for most treatment plans.' },
  { big: '30–40', label: 'minute sessions', text: 'one on one with your therapist.' },
  { big: '6–12', label: 'weeks', text: 'is a typical plan, with regular check-ins.' },
];
---

<BaseLayout
  title="Frequently Asked Questions | Cynergy Physical Therapy"
  description="Quick answers before your first visit: what to wear, insurance, what to bring, your therapist and how often you will come."
>
  <PageHero
    eyebrow="FAQ"
    title="Quick answers before your first visit."
    text="New to physical therapy, or new to Cynergy? Here is what to know before you come in. If you do not see your question, call us and we will help."
    image={img.faq}
    imageAlt="A patient talking with a therapist"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'At Cynergy', href: '/about/' }, { label: 'FAQ' }]}
    primary={{ label: 'Book an appointment', href: '/appointment/' }}
    secondary={{ label: 'Call (212) 974-7252', href: 'tel:+12129747252' }}
  />

  <section class="py-16 lg:py-20">
    <div class="container-x">
      <ul class="grid gap-5 md:grid-cols-3">
        {facts.map((f, n) => (
          <li data-reveal style={`--d:${n * 100}ms`}>
            <div class="h-full rounded-xl bg-pine-900 p-8 text-white">
              <p class="font-serif text-6xl leading-none text-clay-300">{f.big}</p>
              <p class="mt-3 text-lg font-medium">{f.label}</p>
              <p class="mt-1 text-white/75">{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="pb-20 lg:pb-28">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="Your questions" title="Good to know." text="Tap a question to see the answer." />
        <a href="/contact-us/" class="btn btn-outline mt-8" data-reveal>Ask us something else <Arrow /></a>
      </div>
      <div class="lg:col-span-8" data-reveal>
        <Faq client:load items={faqs} />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
