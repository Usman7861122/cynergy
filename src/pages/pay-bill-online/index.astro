---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';
import { locations, telHref } from '@/data/locations';
import { payLinks } from '@/data/pay-links';
---

<BaseLayout
  title="Pay Your Bill Online | Cynergy Physical Therapy"
  description="Pay your Cynergy Physical Therapy bill. Choose your clinic to pay online or call us for help with your bill."
>
  <PageHero
    eyebrow="Pay your bill"
    title="Pay your bill."
    text="Choose the clinic where you were treated. If you need help with your bill, call that clinic and we will help."
    image={img.wide}
    imageAlt="A Cynergy clinic front desk"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Pay your bill' }]}
    primary={{ label: 'Choose your clinic', href: '#clinics' }}
    secondary={{ label: 'Call (212) 974-7252', href: 'tel:+12129747252' }}
  />

  <section id="clinics" class="scroll-mt-24 py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Choose your clinic" title="Where were you treated?" text="Each clinic has its own billing. Pick yours." />
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {locations.map((l, n) => {
          const url = payLinks[l.id];
          return (
            <li data-reveal style={`--d:${(n % 3) * 90}ms`}>
              <article class="flex h-full flex-col rounded-xl border border-pine-900/10 bg-white p-7 transition duration-500 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-pine-950/15">
                <h3 class="text-2xl text-pine-950">{l.name}</h3>
                <address class="mt-3 text-ink/75 not-italic">{l.line1}<br />{l.city}</address>
                <div class="mt-auto flex flex-col gap-3 pt-6">
                  {url && <a href={url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Pay online <Arrow /></a>}
                  <a href={telHref(l)} class:list={['btn', url ? 'btn-outline' : 'btn-primary']}>{url ? 'Call about your bill' : 'Call to pay'} · {l.phone}</a>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
