---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';
import { leaders } from '@/data/providers';

// Content comes from https://cynergypt.com/mentorship-at-cynergy/ (shortened and simplified).
const amira = leaders.find((p) => p.name === 'Amira Murtazaeva');

const programs = [
  {
    title: 'New Grad Mentorship',
    text: 'Build your clinical skills and grow into a full-time caseload as your skills grow.',
    points: ['Weekly meetings with your paired mentor during onboarding, about 3 months', 'Your mentor helps you find and work on areas that need support', 'Scheduled mentor check-ins on day 60 and day 90'],
  },
  {
    title: 'Junior Grad Mentorship',
    text: 'The same goals as New Grad Mentorship, with a plan that fits where you are in your career.',
    points: ['Weekly meetings with your paired mentor, then monthly mentorship after onboarding', 'Chances to visit other Cynergy clinics to build skills, planned with the Director of Mentorship'],
  },
];

const students = ['Shadow a physical therapist at Cynergy', 'See orthopedic physical therapy up close', 'Open to prospective DPT students and pre-med students interested in physical therapy', 'Accepted on a rolling basis'];
---

<BaseLayout
  title="Mentorship at Cynergy | Cynergy Physical Therapy"
  description="How Cynergy trains the next generation of physical therapists: New Grad and Junior Grad mentorship, plus shadowing for students."
>
  <PageHero
    eyebrow="Mentorship"
    title="How we train the next generation."
    text="At Cynergy, we build a culture of learning and respect. Therapists at every level are valued, and asking questions is a strength."
    image={img.portrait}
    imageAlt="A Cynergy therapist"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'At Cynergy', href: '/about/' }, { label: 'Mentorship' }]}
    primary={{ label: 'See careers', href: '/careers-2/' }}
    secondary={{ label: 'Contact us', href: '/contact-us/' }}
  />

  <section class="py-20 lg:py-28">
    <div class="container-x">
      <SectionHeading eyebrow="Two programs" title="Support from your first day." text="Staff at every experience level add to our shared knowledge. Our mentorship runs through two programs." />
      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {programs.map((p, n) => (
          <li data-reveal style={`--d:${n * 100}ms`}>
            <article class="group relative h-full overflow-hidden rounded-xl border border-pine-900/10 bg-white p-8 transition duration-500 hover:-translate-y-1.5 hover:border-transparent hover:bg-pine-900 hover:shadow-xl hover:shadow-pine-950/15 sm:p-10">
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-clay-500 transition-transform duration-500 group-hover:scale-x-100"></span>
              <span class="text-sm tabular-nums text-clay-600 transition-colors group-hover:text-clay-300">0{n + 1}</span>
              <h3 class="mt-4 text-3xl text-pine-950 transition-colors group-hover:text-white">{p.title}</h3>
              <p class="mt-3 text-ink/75 transition-colors group-hover:text-white/80">{p.text}</p>
              <ul class="mt-6 space-y-3">
                {p.points.map((pt) => (
                  <li class="flex items-start gap-3 text-ink/80 transition-colors group-hover:text-white/85">
                    <span class="mt-2.5 h-1.5 w-4 shrink-0 rounded-sm bg-clay-500"></span>{pt}
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-cream-100 py-20 lg:py-28">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2">
      <div data-reveal>
        <SectionHeading eyebrow="For students" title="Thinking about physical therapy?" text="We welcome students who want a closer look at the work." />
        <ul class="mt-8 space-y-4">
          {students.map((s) => (
            <li class="flex items-start gap-4 border-b border-pine-900/15 pb-4 text-lg text-pine-950">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-pine-900 text-white"><Arrow class="h-4 w-4" /></span>{s}
            </li>
          ))}
        </ul>
        <a href="/contact-us/" class="btn btn-primary mt-9">Ask about shadowing <Arrow /></a>
      </div>

      {amira && (
        <div class="grid items-center gap-6 rounded-xl border border-pine-900/10 bg-white p-6 sm:grid-cols-[180px_1fr] sm:p-8" data-reveal style="--d:120ms">
          <img src={amira.image} alt={amira.name} loading="lazy" referrerpolicy="no-referrer" class="aspect-square w-full max-w-[180px] rounded-lg object-cover" />
          <div>
            <p class="eyebrow">Director of Mentorship</p>
            <h3 class="mt-2 text-3xl text-pine-950">{amira.name}</h3>
            <p class="mt-1 text-sm font-semibold uppercase tracking-[0.18em] text-pine-900">{amira.credentials}</p>
            <a href={amira.href} class="btn btn-outline mt-5">Read full bio <Arrow /></a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="container-x">
      <figure class="mx-auto max-w-3xl text-center" data-reveal>
        <svg class="mx-auto h-10 w-10 text-clay-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.2 6C4.9 7.7 3.5 10 3.5 13v5h6v-6H6.3c0-1.7.9-3.1 2.6-4.1L7.2 6Zm9.5 0c-2.3 1.7-3.7 4-3.7 7v5h6v-6h-3.2c0-1.7.9-3.1 2.6-4.1L16.7 6Z" /></svg>
        <blockquote class="mt-5 font-serif text-2xl leading-snug text-pine-950 sm:text-3xl">Mentorship at Cynergy has been beneficial in my growth and development as a new graduate physical therapist.</blockquote>
        <p class="mt-5 text-ink/75">A new graduate says they gained stronger hands-on skills, better assessment, and more confidence with upper-extremity and pre and postnatal patients. They credit weekly case talks and personal feedback for better decision-making.</p>
        <figcaption class="mt-6 text-sm font-semibold uppercase tracking-[0.18em] text-pine-900">New graduate physical therapist</figcaption>
      </figure>
    </div>
  </section>

  <CtaBand
    title="Want to grow with us?"
    text="See open roles on our careers page, or email info@cynergypt.com with any questions."
    eyebrow="Join the team"
    actions={[
      { label: 'See careers', href: '/careers-2/', kind: 'primary' },
      { label: 'Contact us', href: '/contact-us/', kind: 'outline' },
    ]}
  />
</BaseLayout>
