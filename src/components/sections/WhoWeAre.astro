---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Arrow from '@components/ui/Arrow.astro';
import { img } from '@/data/images';

const values = [
  { title: 'One on one', text: 'Every session is private, focused and with your therapist.' },
  { title: 'Whole person', text: 'We tailor care to your goals, from the first evaluation on.' },
  { title: 'Research-based', text: 'Our team keeps learning, with modern equipment and methods.' },
];
---

<section id="about" class="overflow-hidden py-20 lg:py-32">
  <div class="container-x grid items-center gap-16 lg:grid-cols-12">
    <div class="relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none" data-reveal>
      <div class="aspect-[4/5] overflow-hidden rounded-2xl bg-sage-200">
        <img src={img.wellnessDen} alt="A therapist guiding a Pilates reformer class at The Wellness Den" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-full w-full object-cover object-[28%_center]" />
      </div>
    </div>

    <div class="lg:col-span-7 lg:pl-8">
      <SectionHeading eyebrow="Who we are" title="Physical and occupational therapy, made personal." />
      <div class="mt-6 space-y-4 text-lg text-ink/80" data-reveal style="--d:100ms">
        <p>
          Cynergy Physical Therapy offers personalised, cutting-edge rehabilitation and performance care to help you move better and live stronger. Our team of physical, hand and pelvic floor therapists serves patients of all ages with a wide range of diagnoses.
        </p>
        <p>
          Our mission is simple: high-quality, individualised, one on one treatment in a patient-focused, goal-oriented setting. We care for endurance and recreational athletes, competitive athletes, and people recovering from accidents or daily-life injuries.
        </p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {values.map((v, n) => (
          <li data-reveal style={`--d:${150 + n * 100}ms`}>
            <div class="group relative h-full cursor-default overflow-hidden rounded-lg border border-pine-900/10 bg-white/40 p-5 transition duration-500 hover:-translate-y-1.5 hover:border-transparent hover:bg-pine-900 hover:shadow-xl hover:shadow-pine-950/20">
              <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-clay-500 transition-transform duration-500 ease-out group-hover:scale-x-100"></span>
              <span class="text-sm tabular-nums text-clay-600 transition-colors duration-500 group-hover:text-clay-300">0{n + 1}</span>
              <h3 class="mt-3 text-xl text-pine-900 transition-colors duration-500 group-hover:text-white">{v.title}</h3>
              <p class="mt-2 text-sm text-ink/70 transition-colors duration-500 group-hover:text-white/80">{v.text}</p>
            </div>
          </li>
        ))}
      </ul>
      <a href="/about/" class="btn btn-outline group mt-10" data-reveal>About Cynergy <Arrow class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" /></a>
    </div>
  </div>
</section>
