---
import Arrow from '@components/ui/Arrow.astro';

interface Cta { label: string; href: string; external?: boolean }
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  image: string;
  imageAlt?: string;
  crumbs: { label: string; href?: string }[];
  primary: Cta;
  secondary?: Cta;
  /** Short sentence about nearby areas (helps local SEO) */
  areas?: string;
}
const { eyebrow, title, text, image, imageAlt = '', crumbs, primary, secondary, areas } = Astro.props;
---

<section class="relative overflow-hidden bg-pine-950 pb-16 pt-36 text-white lg:pb-24 lg:pt-48">
  <span aria-hidden="true" class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-pine-900"></span>
  <span aria-hidden="true" class="pointer-events-none absolute -bottom-48 -left-32 h-96 w-96 rounded-full bg-pine-900/60"></span>

  <div class="container-x relative grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <nav aria-label="Breadcrumb" data-reveal>
        <ol class="flex flex-wrap items-center gap-2 text-sm text-white/65">
          {crumbs.map((c, n) => (
            <li class="flex items-center gap-2">
              {c.href ? <a href={c.href} class="inline-flex min-h-8 items-center hover:text-white">{c.label}</a> : <span class="text-white" aria-current="page">{c.label}</span>}
              {n < crumbs.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))}
        </ol>
      </nav>
      <p class="eyebrow mt-8 !text-clay-300" data-reveal style="--d:60ms">{eyebrow}</p>
      <h1 class="mt-4 text-4xl font-medium leading-[1.08] sm:text-5xl lg:text-6xl" data-reveal style="--d:120ms">{title}</h1>
      <p class="mt-6 max-w-xl text-lg text-white/80" data-reveal style="--d:180ms">{text}</p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:240ms">
        <a href={primary.href} class="btn btn-primary">{primary.label} <Arrow /></a>
        {secondary && <a href={secondary.href} class="btn btn-outline-light">{secondary.label}</a>}
      </div>
    </div>

    <div class="relative lg:col-span-5" data-reveal style="--d:200ms">
      <span aria-hidden="true" class="absolute -bottom-4 -right-4 h-full w-full rounded-xl border border-clay-300/60"></span>
      <div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-pine-800">
        <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" decoding="async" referrerpolicy="no-referrer" class="h-full w-full object-cover" />
      </div>
    </div>
  </div>

  {areas && (
    <div class="container-x relative mt-14 lg:mt-20" data-reveal style="--d:300ms">
      <div class="flex items-start gap-4 border-t border-white/15 pt-6">
        <svg class="mt-1 h-6 w-6 shrink-0 text-clay-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        <p class="max-w-4xl text-base text-white/75 sm:text-lg">{areas}</p>
      </div>
    </div>
  )}
</section>
