---
import SectionHeading from '@components/ui/SectionHeading.astro';
import TreatList from '@components/islands/TreatList';
import Arrow from '@components/ui/Arrow.astro';
---

<section id="what-we-treat" class="py-20 lg:py-28">
  <div class="container-x">
    <SectionHeading eyebrow="What we treat" title="Pain, injury and everything in between." text="From a stiff neck to complex neurological conditions, we build a plan around you. Hover over a card to flip it." />
    <div class="mt-12" data-reveal>
      <TreatList client:visible />
    </div>
    <div class="mt-12 text-center" data-reveal>
      <a href="/what-we-treat/" class="btn btn-primary">See all conditions <Arrow /></a>
    </div>
  </div>
</section>
