---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Arrow from '@components/ui/Arrow.astro';
import LeadersGrid from '@components/islands/LeadersGrid';
import { ceo } from '@/data/providers';
import { book } from '@/data/book';
---

<section id="providers" class="py-20 lg:py-28">
  <div class="container-x">
    <SectionHeading eyebrow="Our providers" title="Meet the people behind your care." />

    <!-- CEO spotlight -->
    <article class="relative mt-12 overflow-hidden rounded-[2rem] bg-pine-900 text-white" data-reveal>
      <div class="grid items-stretch lg:grid-cols-12">
        <div class="relative min-h-[360px] lg:col-span-5">
          <img src={ceo.image} alt={`${ceo.name}, ${ceo.role}`} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 h-full w-full object-cover object-top" />
          <div class="absolute inset-0 bg-gradient-to-t from-pine-900 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-pine-900"></div>
        </div>
        <div class="relative p-8 sm:p-12 lg:col-span-7 lg:p-16">
          <span aria-hidden="true" class="pointer-events-none absolute right-8 top-2 font-serif text-[10rem] leading-none text-white/5">“</span>
          <p class="eyebrow !text-clay-300">{ceo.role}</p>
          <h3 class="mt-3 text-4xl leading-tight sm:text-5xl">{ceo.name}</h3>
          <p class="mt-2 text-lg text-white/70">{ceo.credentials}</p>
          <p class="mt-8 max-w-xl font-serif text-xl italic leading-relaxed text-white/90 sm:text-2xl">
            Professional, energetic and compassionate care. One on one, with warmth and humor.
          </p>
          <p class="mt-6 max-w-xl text-white/75">
            Cynthia leads a team of physical, hand and pelvic floor therapists who are committed to individualised, one on one care.
          </p>
          <p class="mt-6 max-w-xl text-white/75">
            Cynthia is also the author of <a href="#book" class="font-semibold text-clay-300 underline underline-offset-4 hover:text-white"><em>{book.title}</em></a>, a physical therapist’s guide to overcoming grief, illness and other challenges.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={ceo.href} class="btn btn-primary">Meet our providers <Arrow /></a>
            <a href={book.buyUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-light">Get her book</a>
          </div>
        </div>
      </div>
    </article>

    <LeadersGrid client:visible />
  </div>
</section>
