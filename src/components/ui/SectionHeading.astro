---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  light?: boolean;
}
const { eyebrow, title, text, align = 'left', light = false } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']} data-reveal>
  {eyebrow && <p class:list={['eyebrow', light && '!text-clay-300']}>{eyebrow}</p>}
  <h2
    class:list={[
      'mt-3 text-3xl leading-tight sm:text-4xl lg:text-[2.9rem]',
      light ? 'text-white' : 'text-pine-950',
    ]}
  >
    {title}
  </h2>
  {text && (
    <p class:list={['mt-4 text-base leading-relaxed sm:text-lg', light ? 'text-white/80' : 'text-ink/75']}>
      {text}
    </p>
  )}
</div>
