---
import '../styles/global.css';
import Header from '@components/islands/Header';
import Footer from '@components/sections/Footer.astro';
import CookieConsent from '@components/islands/CookieConsent';

interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
}
const {
  title,
  description = 'Personalised, cutting-edge physical and occupational therapy, Pilates and performance care in New York City.',
  transparentHeader = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#123530" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://cynergypt.com" crossorigin />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-white focus:px-5 focus:py-3 focus:text-pine-950"
    >
      Skip to content
    </a>
    <Header client:load transparentTop={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent client:idle />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
